DATABASE_URL=postgresql+psycopg://exam:exam@localhost:5432/exam
JWT_SECRET=replace-with-at-least-32-random-bytes
STORAGE_DIR=./storage
CORS_ORIGINS=["http://localhost:3000"]

# AI extraction: get a key at https://aistudio.google.com/apikey
EXTRACTION_PROVIDER=gemini          # or "heuristic" for offline regex extraction
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash       # first-pass extraction, per page window (2.5-* is retired for new keys)
GEMINI_VERIFY_MODEL=gemini-3.5-flash  # re-checks flagged questions; Pro needs a paid key (free tier 429s)
GEMINI_FALLBACK_MODELS=["gemini-flash-latest","gemini-3.1-flash-lite"]   # tried in order on 429/503
PAGES_PER_CHUNK=2
EXTRACTION_CONCURRENCY=4
MAX_VERIFY_CALLS=40
EXTRACTION_LANGUAGE=English         # which half of a bilingual paper to keep

# Run the worker inside the API process (dev only). In production run `python -m app.worker`.
EMBEDDED_WORKER=true

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
